rules_version = '2';
// قواعد الحماية لبرنامج متابعة Delta Trading Co.
// المدير الرئيسي: deltatradingco.eg@gmail.com — الفنيون يُضافون من داخل البرنامج
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function hasUser() { return exists(/databases/$(database)/documents/users/$(email())); }
    function userDoc() { return get(/databases/$(database)/documents/users/$(email())).data; }
    function isOwner() { return signedIn() && email() in ['deltatradingco.eg@gmail.com']; }
    function isManager() { return isOwner() || (signedIn() && hasUser() && userDoc().role == 'manager'); }
    function isTech() { return signedIn() && hasUser() && userDoc().role == 'tech'; }
    function myTech() { return userDoc().techId; }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // حسابات الدخول (المديرين والفنيين)
    match /users/{e} {
      allow read: if isManager() || (signedIn() && e == email());
      allow write: if isManager();
    }

    match /meta/{doc} {
      allow read: if isManager() || isTech();
      allow write: if isManager();
    }

    // العملاء: الفني يضيف ويعدّل (بدون تغيير الكود)، والحذف للمدير فقط
    match /clients/{id} {
      allow read: if isManager() || isTech();
      allow create: if isManager() || (isTech() && request.resource.data.createdBy == email());
      allow update: if isManager() || (isTech() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ref', 'seq', 'createdBy']));
      allow delete: if isManager();
    }

    match /techs/{id} {
      allow read: if isManager() || isTech();
      allow write: if isManager();
    }

    // العقود والقيم المالية: المدير فقط
    match /contracts/{id} {
      allow read, write: if isManager();
    }

    // الفواتير وحالة الدفع: المدير فقط
    match /invoices/{id} {
      allow read, write: if isManager();
    }

    // الخطابات الصادرة ومتابعتها: المدير فقط
    match /letters/{id} {
      allow read, write: if isManager();
    }

    // عروض الأسعار وقيمها: المدير فقط
    match /quotes/{id} {
      allow read, write: if isManager();
    }

    // قيمة الأعمال المالية: المدير فقط (منفصلة عن بيانات العمل التي يراها الفني)
    match /jobPrices/{id} {
      allow read, write: if isManager();
    }

    // الملفات المرفوعة: العقود للمدير فقط — صور أوامر الشغل يرفعها ويشوفها الفني أيضاً
    match /files/{id} {
      allow read: if isManager() || (isTech() && resource.data.kind == 'job');
      allow create: if isManager() || (isTech() && request.resource.data.kind == 'job');
      allow update, delete: if isManager();
    }

    // الفني يحدّث حالة وتقرير زياراته ويرفع أمر الشغل فقط
    match /visits/{id} {
      allow read: if isManager() || isTech();
      allow create, delete: if isManager();
      allow update: if isManager() || (isTech() && resource.data.techId == myTech()
                    && onlyChanged(['status', 'work', 'parts', 'notes', 'attachments', 'updatedAt', 'updatedBy']));
    }

    // الأعمال: الفني يضيف أعمالاً جديدة ويتابع أعماله (بدون القيمة المالية)، والحذف للمدير فقط
    match /jobs/{id} {
      allow read: if isManager() || isTech();
      allow create: if isManager() || (isTech() && request.resource.data.createdBy == email()
                    && !request.resource.data.keys().hasAny(['value']));
      allow update: if isManager() || (isTech() && (resource.data.techId == myTech() || resource.data.createdBy == email())
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['value', 'createdBy']));
      allow delete: if isManager();
    }

    // سجل الأعمال اليومية: الفني يسجل ويعدّل سجلاته فقط
    match /logs/{id} {
      allow read: if isManager() || isTech();
      allow create: if isManager() || (isTech() && request.resource.data.techId == myTech());
      allow update: if isManager() || (isTech() && resource.data.techId == myTech() && request.resource.data.techId == myTech());
      allow delete: if isManager();
    }
  }
}
